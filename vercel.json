{
  "version": 2,
  "builds": [
    {
      "src": "ChronoPath/api/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "ChronoPath/frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "ChronoPath/api/main.py"
    },
    {
      "src": "/(.*)",
      "dest": "ChronoPath/frontend/package.json"
    }
  ]
}
